# Copy this file to .env  ->  cp .env.example .env
# Docker Compose reads it automatically. For local (non-Docker) runs the server reads it too.

# --- PostgreSQL container / superuser (used ONLY by migrations & seed) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=slotwise
POSTGRES_PORT=5432

# --- Restricted runtime role (used by the API; subject to Row-Level Security) ---
APP_DB_PASSWORD=app_user_dev_password

# --- Connection strings for running WITHOUT Docker (Compose overrides host with "db") ---
DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/slotwise
DATABASE_URL=postgresql://app_user:app_user_dev_password@localhost:5432/slotwise

# --- API ---
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Must be 32+ characters. Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
